# =========================================================
# Frontend (Vite) environment variables
# Copy to frontend/.env (or root .env) for local development.
# =========================================================

# Base URL of the backend API.
# Local (Vite dev server proxies /api to the backend):
VITE_API_BASE_URL=/api
# Production (Render backend). Keep the trailing /api:
# VITE_API_BASE_URL=https://snake-game-backend-kj85.onrender.com/api

# =========================================================
# Backend environment variables
# Copy the values you need into backend/.env.
# See backend/.env.example for the full list.
# =========================================================

# DATABASE_URL="sqlserver://localhost:1433;database=SnakeCloud;user=sa;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"
# JWT_SECRET=
# JWT_REFRESH_SECRET=
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# FRONTEND_URL=http://localhost:5173
# PORT=4000

# App
APP_NAME=Snake Cloud Backend
APP_VERSION=1.0.0
APP_DESCRIPTION=Backend service for the Snake Cloud project

# Server
NODE_ENV=development
PORT=4000
APP_PORT=4000

# CORS - origin of the frontend (production)
FRONTEND_URL=http://localhost:5173

# Database (Azure SQL / SQL Server)
# Example local: sqlserver://localhost:1433;database=SnakeCloud;user=sa;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=SnakeCloud;user=sa;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Azure Application Insights (optional, do not commit real value)
# APPLICATIONINSIGHTS_CONNECTION_STRING=
